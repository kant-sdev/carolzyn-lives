# Example environment variables for the app.
# Copy this file to `.env.local` and fill the secret values for local development.
# Never commit real secrets to the repo.

TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here
TWITCH_ACCESS_TOKEN=your_app_access_token_here
TWITCH_USERNAME=streamer_name_here
BIBLIA_API_TOKEN=your_biblia_api_token_here
